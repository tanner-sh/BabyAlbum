# 可选配置。不建 .env 也能直接运行，下面都是默认值，需要改哪项就取消注释

# 叠加的配置文件：直接部署在绿联 NAS 上时用 docker-compose.yml:docker-compose.nas.yml
# COMPOSE_FILE=docker-compose.yml

# 宝宝相册的网页端口
# BABY_PORT=3000

# 时区
# TZ=Asia/Shanghai

# Immich 版本（锁定大版本，升级前先看 release notes）
# IMMICH_VERSION=v3

# Immich 数据库密码。数据库不对外开放，一般不用改；要改只能在第一次启动之前改
# DB_PASSWORD=babyalbum

# 强制登录 Cookie 带 Secure 标记。一般不用设，经 HTTPS 访问时会自动加上
# COOKIE_SECURE=false

# NAS 挂载点在宿主机上的目录（Mac 上是 OrbStack 虚拟机里的目录）
# BABYALBUM_HOST_DIR=/var/lib/babyalbum
